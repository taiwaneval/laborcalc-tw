        "type": "string"
       },
       "law_url": {
        "type": "string"
       },
       "last_amended": {
        "type": "string"
       },
       "source": {
        "type": "string"
       },
       "source_file": {
        "type": [
         "string",
         "null"
        ]
       },
       "mirror_commit": {
        "type": [
         "string",
         "null"
        ]
       },
       "mirror_update_date": {
        "type": [
         "string",
         "null"
        ]
       },
       "fetched_at": {
        "type": "string"
       },
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       },
       "inventory": {
        "oneOf": [
         {
          "type": "null"
         },
         {
          "type": "object",
          "properties": {
           "triage_version": {
            "type": [
             "string",
             "null"
            ]
           },
           "articles": {
            "type": "integer"
           },
