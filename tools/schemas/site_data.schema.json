             "type": "object",
             "properties": {
              "unit_id": {
               "type": "string"
              },
              "family": {
               "type": "string"
              },
              "coverage": {
               "enum": [
                "full",
                "partial"
               ]
              },
              "note": {
               "type": [
                "string",
                "null"
               ]
              }
             },
             "required": [
              "unit_id",
              "family",
              "coverage",
              "note"
             ],
             "additionalProperties": false
            }
           },
           "page": {
            "type": "string"
           }
          },
          "required": [
           "triage_version",
           "articles",
           "units",
           "by_category",
           "review",
           "conflicts_open",
           "encoded_units",
           "page"
          ],
          "additionalProperties": false
         }
        ]
       }
      },
      "required": [
       "pcode",
       "law_name",
       "law_url",
       "last_amended",
       "source",
       "source_file",
       "mirror_commit",
       "mirror_update_date",
       "fetched_at",
       "sha256",
       "inventory"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "laws"
   ],
   "additionalProperties": false
  },
  "sources": {
