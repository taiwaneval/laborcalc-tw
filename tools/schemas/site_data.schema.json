         "string",
         "null"
        ]
       },
       "version": {
        "type": [
         "string",
         "null"
        ]
       },
       "source_file": {
        "type": "string"
       },
       "media_type": {
        "type": "string"
       },
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
