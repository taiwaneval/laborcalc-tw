      "required": [
       "source_id",
       "source_type",
       "title",
       "publisher",
       "url",
       "retrieved_url",
       "published_on",
       "document_number",
       "version",
       "source_file",
       "media_type",
       "sha256",
       "fetched_at",
       "fetched_by",
       "license",
       "note",
       "families"
