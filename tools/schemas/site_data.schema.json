{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://taiwaneval.org/schemas/site-data/0.2.0",
 "title": "TaiwanEval site-data bundle",
 "description": "index/<release>/site-data/ 的格式；由 tools/site_data.py 產生並在寫出前驗證。改格式要升 tools/site_data.py 的 SCHEMA_VERSION。照抄 spec 的條目（法源、公式、分支、golden）核心欄位必填、其餘原樣保留；private split 的 run 不附 log_path（log_withheld）。0.2.0：laws 與 sources 只列該 release 題目 lineage 用到的 bronze 快照；新增 sources.json（非法規來源），laws.json 格式不變。",
 "$defs": {
  "manifest": {
   "type": "object",
   "properties": {
    "schema_version": {
     "type": "string"
    },
    "release": {
     "type": "string"
    },
    "mode": {
     "enum": [
      "preview",
      "release"
     ]
    },
    "methodology_version": {
     "type": "string"
    },
    "files": {
     "type": "object",
     "properties": {
      "laws.json": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "families.json": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "results.json": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "sources.json": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      }
     },
     "required": [
      "laws.json",
      "families.json",
      "results.json",
      "sources.json"
     ],
     "additionalProperties": false
    },
    "sources": {
     "type": "object",
     "additionalProperties": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     }
    }
   },
   "required": [
    "schema_version",
    "release",
    "mode",
    "methodology_version",
    "files",
    "sources"
   ],
   "additionalProperties": false
  },
  "laws": {
